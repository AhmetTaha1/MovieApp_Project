<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ===== HEADER: Avatar + Name + Email ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/home_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="28dp"
            android:paddingHorizontal="20dp">

            <!-- Big avatar circle -->
            <TextView
                android:id="@+id/tv_avatar"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_circle_red"
                android:gravity="center"
                android:text="?"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Username"
                android:textColor="@color/home_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="email@example.com"
                android:textColor="@color/home_text_secondary"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- ===== STATS ROW ===== -->
        <!-- İki kart da aynı yapıda → otomatik eşit yükseklik -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp">

            <!-- Favorites Count Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/home_surface"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/tv_favorites_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/red_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/favorites"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="13sp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Top Genre Card — aynı yapı, eşit yükseklik garantisi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/home_surface"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/tv_top_genre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/home_text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/top_genre"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="13sp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ===== MY FAVORITES ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_favorites"
                android:textColor="@color/home_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <TextView
                android:id="@+id/tv_see_all_favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_all"
                android:textColor="@color/home_text_secondary"
                android:textSize="14sp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <!-- Favorites horizontal scroll -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_profile_favorites"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"/>

        <!-- Empty favorites state -->
        <LinearLayout
            android:id="@+id/ll_empty_favorites"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_favorites"
                android:textColor="@color/home_text_secondary"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/start_adding_movies"
                android:textColor="#555555"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- ===== DIVIDER ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="28dp"
            android:background="#2A2A2A"/>

        <!-- ===== ACTION BUTTONS ===== -->

        <!-- AI Recommendations Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ai_recommendations"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:text="@string/get_ai_recommendations"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="@color/red_primary"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_recommend"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"/>

        <!-- Sign Out Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sign_out"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:text="@string/sign_out"
            android:textSize="15sp"
            android:textColor="@color/home_text_primary"
            app:backgroundTint="@color/home_surface"
            app:cornerRadius="12dp"
            app:strokeColor="#444444"
            app:strokeWidth="1dp"/>

        <!-- ===== DIVIDER ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:background="#2A2A2A"/>

        <!-- ===== SETTINGS ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:text="@string/settings"
            android:textColor="@color/home_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/home_surface"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!-- Dark Mode Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dark_mode"
                        android:textColor="@color/home_text_primary"
                        android:textSize="15sp"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_dark_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <!-- Row divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"/>

                <!-- Language Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/language"
                        android:textColor="@color/home_text_primary"
                        android:textSize="15sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lang_en"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="52dp"
                        android:layout_height="36dp"
                        android:text="EN"
                        android:textSize="13sp"
                        android:textColor="@color/home_text_primary"
                        android:minWidth="0dp"
                        android:paddingHorizontal="0dp"
                        app:strokeColor="#555555"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lang_tr"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="52dp"
                        android:layout_height="36dp"
                        android:text="TR"
                        android:textSize="13sp"
                        android:textColor="@color/home_text_primary"
                        android:minWidth="0dp"
                        android:paddingHorizontal="0dp"
                        android:layout_marginStart="8dp"
                        app:strokeColor="#555555"
                        app:cornerRadius="8dp"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Admin Panel Button — yalnızca admin kullanıcılara görünür -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_panel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:text="@string/admin_panel"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#2A2A2A"
            app:cornerRadius="12dp"
            app:strokeColor="#555555"
            app:strokeWidth="1dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
