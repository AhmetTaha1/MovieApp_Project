<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Film posteri -->
        <ImageView
            android:id="@+id/iv_poster"
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Geri butonu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_small"
            app:icon="@android:drawable/ic_media_previous"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Favoriye ekle butonu -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_favorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            app:srcCompat="@android:drawable/btn_star"
            app:backgroundTint="@color/red_primary"
            app:layout_constraintBottom_toBottomOf="@id/iv_poster"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Film adı -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_title"
            android:textColor="@color/on_surface"
            android:textStyle="bold"
            android:padding="@dimen/padding_medium"
            app:layout_constraintTop_toBottomOf="@id/iv_poster"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- IMDB puanı -->
        <TextView
            android:id="@+id/tv_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_medium"
            android:textColor="@color/rating_color"
            android:textStyle="bold"
            android:paddingStart="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Yıl -->
        <TextView
            android:id="@+id/tv_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_medium"
            android:textColor="@color/text_secondary"
            android:paddingStart="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/tv_rating"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Tür -->
        <TextView
            android:id="@+id/tv_genre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_medium"
            android:textColor="@color/text_secondary"
            android:paddingStart="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/tv_year"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Yönetmen -->
        <TextView
            android:id="@+id/tv_director"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_medium"
            android:textColor="@color/text_secondary"
            android:paddingStart="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/tv_genre"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Özet başlığı -->
        <TextView
            android:id="@+id/tv_summary_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/movie_summary"
            android:textSize="@dimen/text_large"
            android:textColor="@color/on_surface"
            android:textStyle="bold"
            android:paddingStart="@dimen/padding_medium"
            android:paddingTop="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/tv_director"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Özet -->
        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_medium"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.5"
            android:padding="@dimen/padding_medium"
            app:layout_constraintTop_toBottomOf="@id/tv_summary_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Fragman butonu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_trailer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:text="@string/trailer"
            app:icon="@android:drawable/ic_media_play"
            app:backgroundTint="@color/red_primary"
            app:layout_constraintTop_toBottomOf="@id/tv_summary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>